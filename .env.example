EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-key-here

# ── Multi-passenger ongoing ride ─────────────────────────────────────────────
# Default OFF: single-passenger behavior is untouched until this is true.
# EXPO_PUBLIC_* values are inlined at build time, so restart Expo (or rebuild)
# after changing this. Run supabase/migration_multi_passenger.sql first.
EXPO_PUBLIC_ENABLE_MULTI_PASSENGER_RIDE=false

# ── Web "Install app" button ────────────────────────────────────────────────
# Leave EXPO_PUBLIC_APK_URL EMPTY to see the banner in its "installer not
# configured" state. Nothing is downloaded until you set it.
#
# To publish the APK and get a permanent URL:
#   eas build:download --platform android        # pull the .apk off EAS
#   gh release create v1.0.0 ./application-<build-id>.apk --title "TriRide 1.0.0"
#
# Then point this at the release asset. The "latest" alias is the point: it
# always serves your newest release, so you never edit this line again and
# every install link you have already handed out keeps working.
#
# Do NOT put the EAS build page URL here
# (expo.dev/accounts/.../builds/<id>). That is a login-gated dashboard page,
# not a file: a visitor gets sent to a sign-in wall and a <a download> would
# save an HTML page with an .apk name.
EXPO_PUBLIC_APK_URL=

# Optional. Only used for the small "View build details" link in the banner.
EXPO_PUBLIC_BUILD_URL=

# NOTE: There is deliberately no EXPO_PUBLIC_RESEND_API_KEY.
# Anything prefixed EXPO_PUBLIC_ is inlined into the client bundle and is
# therefore public the moment this app is deployed to a website. Email and
# SMS go through the notify-approval Supabase Edge Function, which reads its
# credentials from Deno.env (set with `supabase secrets set`).
# See: supabase/functions/notify-approval/index.ts
#
# The two install values above are safe to expose for the same reason the APK
# itself is public: they are download links to a file anyone is meant to get.
